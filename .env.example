# Copy this file to .env and fill in only what you use.
# .env is git-ignored, so your keys never end up on GitHub.

# Weather tool (free key: https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Claude (only needed with --provider anthropic)
ANTHROPIC_API_KEY=

# Inventory database: "tinysql" (default, zero setup), "sqlite" or "mariadb"
DB_BACKEND=tinysql

# MariaDB settings (only used when DB_BACKEND=mariadb)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MYSTORE
DB_USER=
DB_PASSWORD=

# Your time zone, e.g. Europe/Rome (empty: this computer's). It decides which day
# TODAY is in the database, which matters near midnight and on a server set to another zone.
LITTLE_MCP_TIMEZONE=

# Ollama embedding model used for document search
EMBED_MODEL=nomic-embed-text
